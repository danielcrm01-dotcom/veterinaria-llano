# mongod.cfg (Windows: C:\Program Files\MongoDB\Server\<version>\bin\mongod.cfg | Linux: /etc/mongod.conf)
storage:
  dbPath: C:\Program Files\MongoDB\Server\8.0\data
net:
  port: 27017
  bindIp: 127.0.0.1        # solo conexiones locales
systemLog:
  destination: file
  path: C:\Program Files\MongoDB\Server\8.0\log\mongod.log
  logAppend: true

# --- Sección pedida en la actividad ---
security:
  authorization: enabled
